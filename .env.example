# Copy to .env and fill in. Never commit the real .env file.

# Roostoo API credentials (request via jolly@roostoo.com)
ROOSTOO_API_KEY=
ROOSTOO_API_SECRET=

# development | paper | live
APP_ENV=development

# The bot refuses to submit real orders unless this is exactly "true"
# AND APP_ENV is "live". This is a deliberate double gate against
# accidental live trading from a dev/paper config.
LIVE_TRADING=false
